# hw definition file for processing by chibios_pins.py
# for minimal F405 bootloader — FlashHobbyF405
# MCU class and specific type
MCU STM32F4xx STM32F405xx
# board ID — MUST match APJ_BOARD_ID in the main hwdef.dat
APJ_BOARD_ID 5301
# crystal frequency
OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 1024
# bootloader is installed at zero offset
FLASH_RESERVE_START_KB 0
# the location where the bootloader will put the firmware
# (must match FLASH_RESERVE_START_KB in the main hwdef.dat)
FLASH_BOOTLOADER_LOAD_KB 64
# order of UARTs
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
# Add CS pins to ensure they are high (deselected) in bootloader —
# pin numbers match the real board pinout from INAV target.c
PA4  IMU_CS   CS
PB12 OSD_CS   CS
PA15 FLASH_CS CS
